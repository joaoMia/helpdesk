// DEV-002: minimum core authorized for the first development migration.
// Pending permissions, conditional forms, calendars and projects are not implemented.
// PostgreSQL checks/triggers live in the reviewed migration, not in PSL.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TECHNICIAN
  REQUESTER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum ServiceFieldType {
  TEXT
  LONG_TEXT
  SELECT
  MULTI_SELECT
  DATE_TIME
  FILE
  CHECKBOX
}

model User {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role               UserRole
  name               String
  email              String        @unique
  passwordHash       String        @map("password_hash")
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  isActive           Boolean       @default(true) @map("is_active")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  requestedTickets   Ticket[]      @relation("Requester")
  assignedTickets    Ticket[]      @relation("Technician")
  classifiedTickets  Ticket[]      @relation("Classifier")
  closedTickets      Ticket[]      @relation("Closer")
  events             TicketEvent[]
  authSessions       AuthSession[]

  @@map("users")
}

model ServiceCategory {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  description  String    @default("")
  isActive     Boolean   @default(true) @map("is_active")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  services     Service[]

  @@map("service_categories")
}

model Service {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String               @map("category_id") @db.Uuid
  category     ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name         String
  description  String               @default("")
  isActive     Boolean              @default(true) @map("is_active")
  displayOrder Int                  @default(0) @map("display_order")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  forms        ServiceFormVersion[]
  tickets      Ticket[]

  @@index([categoryId, isActive, displayOrder])
  @@map("services")
}

model ServiceFormVersion {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String             @map("service_id") @db.Uuid
  service   Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  version   Int
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  fields    ServiceFormField[]
  tickets   Ticket[]

  @@unique([serviceId, version])
  @@unique([serviceId, id])
  @@map("service_form_versions")
}

model ServiceFormField {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formVersionId String             @map("form_version_id") @db.Uuid
  formVersion   ServiceFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  key           String
  label         String
  type          ServiceFieldType
  required      Boolean            @default(false)
  displayOrder  Int                @default(0) @map("display_order")
  options       Json?              @db.JsonB
  condition     Json?              @db.JsonB
  answers       TicketAnswer[]

  @@unique([formVersionId, key])
  @@unique([formVersionId, id, key])
  @@map("service_form_fields")
}

model Ticket {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 Int                @unique @default(autoincrement())
  requesterId          String             @map("requester_id") @db.Uuid
  requester            User               @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  serviceId            String             @map("service_id") @db.Uuid
  service              Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  formVersionId        String             @map("form_version_id") @db.Uuid
  formVersion          ServiceFormVersion @relation(fields: [serviceId, formVersionId], references: [serviceId, id], onDelete: Restrict, onUpdate: Restrict)
  subject              String
  description          String
  status               TicketStatus       @default(OPEN)
  priority             TicketPriority?
  assignedTechnicianId String?            @map("assigned_technician_id") @db.Uuid
  assignedTechnician   User?              @relation("Technician", fields: [assignedTechnicianId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  classifiedAt         DateTime?          @map("classified_at") @db.Timestamptz(3)
  classifiedById       String?            @map("classified_by_id") @db.Uuid
  classifiedBy         User?              @relation("Classifier", fields: [classifiedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  firstStartedAt       DateTime?          @map("first_started_at") @db.Timestamptz(3)
  closedAt             DateTime?          @map("closed_at") @db.Timestamptz(3)
  closedById           String?            @map("closed_by_id") @db.Uuid
  closedBy             User?              @relation("Closer", fields: [closedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  serviceSnapshot      Json               @map("service_snapshot") @db.JsonB
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  answers              TicketAnswer[]
  events               TicketEvent[]

  @@unique([id, formVersionId])
  @@index([requesterId, createdAt])
  @@index([status, priority, createdAt])
  @@index([assignedTechnicianId, status])
  @@index([serviceId, formVersionId])
  @@map("tickets")
}

model TicketAnswer {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId      String           @map("ticket_id") @db.Uuid
  formVersionId String           @map("form_version_id") @db.Uuid
  ticket        Ticket           @relation(fields: [ticketId, formVersionId], references: [id, formVersionId], onDelete: Cascade, onUpdate: Restrict)
  fieldId       String           @map("field_id") @db.Uuid
  fieldKey      String           @map("field_key")
  field         ServiceFormField @relation(fields: [formVersionId, fieldId, fieldKey], references: [formVersionId, id, key], onDelete: Restrict, onUpdate: Restrict)
  value         Json             @db.JsonB
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([ticketId, fieldKey])
  @@index([formVersionId, fieldId, fieldKey])
  @@map("ticket_answers")
}

model TicketEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  actorId   String?  @map("actor_id") @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  eventType String   @map("event_type")
  oldValue  Json?    @map("old_value") @db.JsonB
  newValue  Json     @map("new_value") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

model AuthSession {
  id            String             @id @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(3)
  lastUsedAt    DateTime           @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt     DateTime?          @map("revoked_at") @db.Timestamptz(3)
  revokeReason  String?            @map("revoke_reason")
  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthRefreshToken {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String      @map("session_id") @db.Uuid
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tokenHash  String      @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?   @map("consumed_at") @db.Timestamptz(3)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("auth_refresh_tokens")
}
