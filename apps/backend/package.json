{
  "name": "@helpdesk/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:core": "npm run build --workspace @helpdesk/contracts && npm run prisma:generate",
    "pretypecheck": "npm run prepare:core",
    "predev": "npm run prepare:core",
    "prebuild": "npm run prepare:core",
    "pretest": "npm run prepare:core",
    "pretest:db": "npm run prepare:core",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "tsx scripts/migrate-development.ts",
    "db:migrate:status": "prisma migrate status",
    "db:prisma:check": "tsx scripts/check-prisma.ts",
    "test:db": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.integration.config.mjs --runInBand",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.mjs --runInBand"
  },
  "dependencies": {
    "@helpdesk/contracts": "0.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "cookie": "2.0.1",
    "cors": "2.8.6",
    "csrf-csrf": "4.0.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15"
  }
}
