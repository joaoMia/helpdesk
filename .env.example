# Copie os nomes ou execute npm run env:setup para gerar credenciais locais.
# Não use este arquivo como configuração de produção.
POSTGRES_USER=helpdesk_app
POSTGRES_PASSWORD=
POSTGRES_DB=helpdesk_dev
POSTGRES_TEST_DB=helpdesk_test
POSTGRES_PORT=5432
DATABASE_URL=
TEST_DATABASE_URL=
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
# Gere duas chaves distintas com npm run auth:env:setup, nunca copie valores reais.
AUTH_JWT_SECRET=
AUTH_CSRF_SECRET=
AUTH_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# A exceção HTTP somente funciona em development/test, origens e conexão loopback.
# Em HTTPS/produção: AUTH_COOKIE_SECURE=true e AUTH_ALLOW_LOCAL_HTTP=false.
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_LOCAL_HTTP=true
